<?xml version="1.0" encoding="utf-8"?>
<!-- Small: Judah fills the tile, verse reference underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/judah_widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/judah_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Judah"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/verse_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/verse_ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:padding="6dp"
        android:textColor="#C97E14"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
